SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://ltltv:ltltv@db:5432/ltltv
REDIS_URL=redis://redis:6379/0
CLOUDINARY_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of Django (nginx = 1). Rate limits and
# stored submitter IPs trust only the X-Forwarded-For entries they append.
NUM_PROXIES=1
# Self-service sign-up on /api/v1/accounts/register/ (off: no public account area).
ALLOW_PUBLIC_REGISTRATION=False

# SMTP — mailbox hosted at Hostinger (hPanel > Emails > info@ltltv.com).
# Leave EMAIL_HOST_PASSWORD empty locally: emails print to the console instead
# of actually sending while DEBUG=True.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@ltltv.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LTL·TV <info@ltltv.com>

FRONTEND_URL=https://ltltv.com
